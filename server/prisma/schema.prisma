// Prisma schema for EduMaster LMS - Supabase PostgreSQL Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String              @id @default(uuid())
  username              String
  email                 String              @unique
  password              String
  role                  String              @default("student") // 'admin' | 'student'
  isActive              Boolean             @default(true)
  avatarPublicId        String?             @default("default_avatar_id")
  avatarSecureUrl       String?             @default("default_avatar_url")
  forgotPasswordToken   String?
  forgotPasswordExpires DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  createdCourses        Course[]            @relation("CourseAuthor")
  enrollments           CourseEnrollment[]
  progresses            Progress[]

  @@map("users")
}

model Course {
  id                  String              @id @default(uuid())
  title               String
  description         String
  category            String
  thumbnailPublicId   String?             @default("default_thumbnail_id")
  thumbnailSecureUrl  String?             @default("default_thumbnail_url")
  numberOfLectures    Int                 @default(0)
  createdById         String?
  createdBy           String              @default("EduMaster Admin")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  author              User?               @relation("CourseAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  lectures            Lecture[]
  enrollments         CourseEnrollment[]
  progresses          Progress[]

  @@map("courses")
}

model Lecture {
  id                  String              @id @default(uuid())
  courseId            String
  title               String
  description         String?
  publicId            String
  secureUrl           String
  orderIndex          Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  course              Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lastWatchedProgress Progress[]          @relation("LastWatchedLecture")
  completions         LectureCompletion[]

  @@map("lectures")
}

model CourseEnrollment {
  id                  String              @id @default(uuid())
  userId              String
  courseId            String
  enrolledAt          DateTime            @default(now())

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  course              Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("course_enrollments")
}

model Progress {
  id                   String              @id @default(uuid())
  userId               String
  courseId             String
  lastWatchedLectureId String?
  lastPlaybackTime     Float               @default(0)
  progressPercentage   Int                 @default(0)
  isCompleted          Boolean             @default(false)
  completedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lastWatchedLecture   Lecture?            @relation("LastWatchedLecture", fields: [lastWatchedLectureId], references: [id], onDelete: SetNull)
  completedLectures    LectureCompletion[]

  @@unique([userId, courseId])
  @@map("progress")
}

model LectureCompletion {
  id                  String              @id @default(uuid())
  progressId          String
  lectureId           String
  completedAt         DateTime            @default(now())

  progress            Progress            @relation(fields: [progressId], references: [id], onDelete: Cascade)
  lecture             Lecture             @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@unique([progressId, lectureId])
  @@map("lecture_completions")
}
